{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "edition_date": {"type": "string", "minLength": 10},
    "digest_title": {"type": "string", "minLength": 4},
    "executive_summary": {"type": "string", "minLength": 20},
    "reference_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "minLength": 2},
          "url": {"type": "string", "minLength": 8},
          "purpose": {"type": "string", "minLength": 4},
          "status": {"type": "string", "enum": ["supported", "partial", "unverified"]}
        },
        "required": ["title", "url", "purpose", "status"],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "rank": {"type": "integer"},
          "title": {"type": "string", "minLength": 2},
          "event_time": {"type": "string", "minLength": 8},
          "summary": {"type": "string", "minLength": 10},
          "why_it_matters": {"type": "string", "minLength": 10},
          "risk_note": {"type": "string", "minLength": 8},
          "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "text": {"type": "string", "minLength": 4},
                "status": {"type": "string", "enum": ["supported", "partial", "conflicting", "unverified"]},
                "evidence_urls": {"type": "array", "items": {"type": "string"}}
              },
              "required": ["text", "status", "evidence_urls"],
              "additionalProperties": false
            }
          }
        },
        "required": ["rank", "title", "event_time", "summary", "why_it_matters", "risk_note", "source_urls", "claims"],
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "platform": {"type": "string", "enum": ["wechat", "woshipm"]},
          "title": {"type": "string", "minLength": 4},
          "angle": {"type": "string", "minLength": 8},
          "audience_decision": {"type": "string", "minLength": 6},
          "new_value": {"type": "string", "minLength": 8},
          "required_claims": {"type": "array", "items": {"type": "string"}},
          "avoid": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["platform", "title", "angle", "audience_decision", "new_value", "required_claims", "avoid"],
        "additionalProperties": false
      }
    }
  },
  "required": ["edition_date", "digest_title", "executive_summary", "reference_materials", "items", "topics"],
  "additionalProperties": false
}
